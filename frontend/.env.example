# BorderGuard AI — frontend environment (copy to .env and adjust as needed)
#
# Where the frontend sends API requests.
#   - Leave EMPTY for local dev: requests stay same-origin (/api ...) and the
#     Vite dev server proxies them to the backend (recommended).
#   - Set to a full origin to point a built/preview app at a backend directly,
#     e.g. on a demo/projector machine or another host on the LAN:
#         VITE_API_URL=http://localhost:8000
#         VITE_API_URL=http://192.168.1.50:8000
VITE_API_URL=

# Optional: override the dev-server proxy target (defaults to http://localhost:8000).
# Useful if the backend runs on a different port or host during development.
# VITE_DEV_PROXY_TARGET=http://localhost:8000
